# MadGraph5 batch script: p p > e+ e- j with xqcut as a pure cut (ickkw = 0).
# built-by: validation/madgraph/gen_mlm_references.sh
#
# pp_to_llj_mlm's run card with ickkw = 0 and nothing else changed. MadEvent
# then reads xqcut = 20 as a cut on the clustering's jet vertices and nothing
# more: setclscales returns after the rejection test (the ickkw = 0 early
# return, reweight.f:1103), there is no second call and rewgt is 1. The
# setcuts.f rewrite still applies (ptj = mmjj = xqcut, drjj = drjl = 0), and
# banner.py logs an error and sleeps 5 s over the combination before running
# it. Beside pp_to_llj_mlm, this row separates the cut from the reweighting:
# a cross section that agrees here and disagrees there is rewgt's.
generate p p > e+ e- j
output pp_to_llj_xqcut_only -nojpeg
launch
  set ebeam1 6500
  set ebeam2 6500
  set fixed_ren_scale False
  set fixed_fac_scale1 False
  set fixed_fac_scale2 False
  set scale 91.188
  set dsqrt_q2fact1 91.188
  set dsqrt_q2fact2 91.188
  set dynamical_scale_choice -1
  set pdlabel1 lhapdf
  set pdlabel2 lhapdf
  set lhaid 247000
  set mmll 50
  set ickkw 0
  set xqcut 20
  set vector_size 1
  set systematics_program none
  done
