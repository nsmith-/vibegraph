# MadGraph5 batch script: d d~ > e+ e- g at LO, QCD=2 QED=2.
#
# The down-type partner of uux_to_epemg: identical topology and colour
# structure, different electroweak couplings (charge -1/3 photon coupling and
# the down-type Z vector/axial pair). Holding everything but the initial
# flavour fixed makes a coupling-table error separable from a topology or
# flow-convention error, which the two rows would fail together on.
#
# lpp=0 => fixed-energy partonic beams (d, d~).
generate d d~ > e+ e- g QCD=2 QED=2
output ddx_to_epemg -nojpeg
launch
set lpp1 0
set lpp2 0
set ebeam1 250
set ebeam2 250
set use_syst False
done
