+      subroutine vg_tables()
+c**************************************************************************
+c     The merge graph as filmap left it: which configs a mask can be reached
+c     from, the propagator identity each config gives it, which are resonant,
+c     and the iforest the whole thing was derived from. Emitted once per
+c     process directory per integration channel — the nqcd filter at the top
+c     of filmap makes the table a function of the channel, not of the process.
+c**************************************************************************
+      implicit none
+      include 'genps.inc'
+      include 'nexternal.inc'
+      include 'maxamps.inc'
+      include 'cluster.inc'
+      include 'coupl.inc'
+      include 'ktdump.inc'
+      integer mapconfig(0:lmaxconfigs), this_config
+      common/to_mconfigs/mapconfig, this_config
+      integer iforest(2,-max_branch:-1,lmaxconfigs)
+      integer tstrategy(lmaxconfigs)
+      common/to_forest/iforest, tstrategy
+      integer sprop(maxsproc,-max_branch:-1,lmaxconfigs)
+      integer tprid(-max_branch:-1,lmaxconfigs)
+      common/to_sprop/sprop,tprid
+      integer nqcd(lmaxconfigs)
+      include 'config_nqcd.inc'
+      double precision ZERO
+      parameter (ZERO=0d0)
+      double precision prmass(-nexternal:0,lmaxconfigs)
+      double precision prwidth(-nexternal:0,lmaxconfigs)
+      integer pow(-nexternal:0,lmaxconfigs)
+      integer i, j, k, iproc
+      logical vg_active
+      external vg_active
+
+      if (.not.vg_active()) return
+c     props.inc assigns only the propagators a config has, so the rest of the
+c     array would be whatever the stack held.
+      do i=1,lmaxconfigs
+         do j=-nexternal,0
+            prmass(j,i)=0d0
+            prwidth(j,i)=0d0
+            pow(j,i)=0
+         enddo
+      enddo
+      include 'props.inc'
+
+      call vg_beg('RUN')
+      call vg_i(this_config)
+      call vg_i(nexternal)
+      call vg_i(nincoming)
+      call vg_i(maxsproc)
+      call vg_i(mapconfig(0))
+      call vg_i(n_max_cl)
+      call vg_i(n_max_cg)
+      call vg_now()
+
+      do i=1,mapconfig(0)
+         call vg_beg('NQCD')
+         call vg_i(this_config)
+         call vg_i(i)
+         call vg_i(nqcd(i))
+         call vg_now()
+      enddo
+
+      do iproc=1,maxsproc
+         do i=1,n_max_cl
+            if (id_cl(iproc,i,0).le.0) cycle
+            call vg_beg('MAP')
+            call vg_i(this_config)
+            call vg_i(iproc)
+            call vg_i(i)
+            call vg_i(id_cl(iproc,i,0))
+            do j=1,id_cl(iproc,i,0)
+               call vg_i(id_cl(iproc,i,j))
+            enddo
+            call vg_now()
+            do j=1,id_cl(iproc,i,0)
+               call vg_beg('PDG')
+               call vg_i(this_config)
+               call vg_i(iproc)
+               call vg_i(i)
+               call vg_i(id_cl(iproc,i,j))
+               call vg_i(ipdgcl(i,id_cl(iproc,i,j),iproc))
+               call vg_now()
+            enddo
+         enddo
+      enddo
+
+      do i=1,n_max_cl
+         do j=1,mapconfig(0)
+            if (.not.resmap(i,j)) cycle
+            call vg_beg('RES')
+            call vg_i(this_config)
+            call vg_i(i)
+            call vg_i(j)
+            call vg_now()
+         enddo
+      enddo
+
+      do i=1,mapconfig(0)
+         do k=-1,-(nexternal-2),-1
+            if (iforest(1,k,i).eq.0.and.iforest(2,k,i).eq.0) cycle
+            call vg_beg('IFOR')
+            call vg_i(this_config)
+            call vg_i(i)
+            call vg_i(k)
+            call vg_i(iforest(1,k,i))
+            call vg_i(iforest(2,k,i))
+            call vg_i(tprid(k,i))
+            call vg_d(prmass(k,i))
+            call vg_d(prwidth(k,i))
+            do iproc=1,maxsproc
+               call vg_i(sprop(iproc,k,i))
+            enddo
+            call vg_now()
+         enddo
+      enddo
+      return
+      end
+
