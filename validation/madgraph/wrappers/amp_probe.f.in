C     Per-diagram amplitude + per-flow JAMP probe (any process): @NGRAPHS@ and
C     @NCOLOR@ are substituted with the process's NGRAPHS/NCOLOR by
C     build_amplitude.sh.
C
C     Exposes MadGraph's individual AMP(1:NGRAPHS) and the per-color-flow
C     JAMP(1:NCOLOR) for one explicit helicity assignment, so vibegraph's
C     per-diagram amplitudes AND per-flow JAMPs can be matched against MadGraph
C     diagram-by-diagram and flow-by-flow (validation/madgraph/compare_amps.py).
C     Relies on the COMMON/DBG_AMP/ and COMMON/DBG_JAMP/ blocks patched into
C     matrix1_orig.f's MATRIX1 at build time (build_amplitude.sh
C     build_amp_dump_probe), which copy AMP/JAMP into AMP_DBG/JAMP_DBG each call.
C
C       P           REAL*8 P(0:3, NEXTERNAL): external 4-momenta [E,px,py,pz]
C       NHEL        INTEGER NHEL(NEXTERNAL): helicities (+/-1) per leg
C       PARAM_PATH  path to param_card.dat (read once on first call)
C       AMP_OUT     COMPLEX*16 AMP_OUT(NGRAPHS): per-diagram amplitudes
C       JAMP_OUT    COMPLEX*16 JAMP_OUT(NCOLOR): per-color-flow JAMPs
C     A second entry point returning only MATRIX1's own value: the
C     colour-summed |M|^2 of one helicity assignment. Summed over the process's
C     NHEL table it is MadGraph's helicity- and colour-summed |M|^2, which is
C     what wrappers/generic.f produces for a process whose matrix element went
C     through helicity recycling. A 2 -> 1 process has no phase space for
C     MadEvent to integrate, so its `launch` stops before recycling and leaves
C     the per-helicity matrix element in place; this is how such a row reaches
C     the same number.
      SUBROUTINE MG_EVAL_M2_HEL(P, NHEL, PARAM_PATH, M2_OUT)
Cf2py intent(in)  P, NHEL, PARAM_PATH
Cf2py intent(out) M2_OUT
      IMPLICIT NONE
      INTEGER    NGRAPHS
      PARAMETER (NGRAPHS=@NGRAPHS@)
      INTEGER    NCOLOR
      PARAMETER (NCOLOR=@NCOLOR@)
      INCLUDE 'nexternal.inc'
      INCLUDE 'maxamps.inc'
      CHARACTER*(*) PARAM_PATH
      REAL*8 P(0:3, NEXTERNAL)
      INTEGER NHEL(NEXTERNAL)
      REAL*8 M2_OUT
      DOUBLE PRECISION AMP2(MAXAMPS), JAMP2(0:MAXFLOW)
      REAL*8 MATRIX1
      INTEGER IC(NEXTERNAL), I
      LOGICAL FIRST2
      SAVE FIRST2
      DATA FIRST2 /.TRUE./

      IF (FIRST2) THEN
        CALL SETPARA(PARAM_PATH)
        FIRST2 = .FALSE.
      ENDIF

      DO I = 1, NEXTERNAL
        IC(I) = 1
      END DO

      M2_OUT = MATRIX1(P, NHEL, IC, 1, AMP2, JAMP2, 1)
      END

      SUBROUTINE MG_EVAL_AMP(P, NHEL, PARAM_PATH, AMP_OUT, JAMP_OUT)
Cf2py intent(in)  P, NHEL, PARAM_PATH
Cf2py intent(out) AMP_OUT, JAMP_OUT
      IMPLICIT NONE
      INTEGER    NGRAPHS
      PARAMETER (NGRAPHS=@NGRAPHS@)
      INTEGER    NCOLOR
      PARAMETER (NCOLOR=@NCOLOR@)
      INCLUDE 'nexternal.inc'
      INCLUDE 'maxamps.inc'
      CHARACTER*(*) PARAM_PATH
      REAL*8 P(0:3, NEXTERNAL)
      INTEGER NHEL(NEXTERNAL)
      COMPLEX*16 AMP_OUT(NGRAPHS)
      COMPLEX*16 JAMP_OUT(NCOLOR)
C     MadGraph 3.7.x passes the per-configuration AMP2 and the per-flow JAMP2 as
C     arguments where 3.5.x kept them in a COMMON block; MATRIX1 writes into
C     both, so they are supplied here as scratch and not read back. The
C     per-diagram and per-flow values this probe returns come from the
C     COMMON/DBG_*/ blocks patched into MATRIX1 itself.
      DOUBLE PRECISION AMP2(MAXAMPS), JAMP2(0:MAXFLOW)

      COMPLEX*16 AMP_DBG(NGRAPHS)
      COMMON/DBG_AMP/AMP_DBG
      COMPLEX*16 JAMP_DBG(NCOLOR)
      COMMON/DBG_JAMP/JAMP_DBG

      REAL*8 MATRIX1, T
      INTEGER IC(NEXTERNAL), I
      LOGICAL FIRST
      SAVE FIRST
      DATA FIRST /.TRUE./

      IF (FIRST) THEN
        CALL SETPARA(PARAM_PATH)
        FIRST = .FALSE.
      ENDIF

      DO I = 1, NEXTERNAL
        IC(I) = 1
      END DO

      T = MATRIX1(P, NHEL, IC, 1, AMP2, JAMP2, 1)

      DO I = 1, NGRAPHS
        AMP_OUT(I) = AMP_DBG(I)
      END DO
      DO I = 1, NCOLOR
        JAMP_OUT(I) = JAMP_DBG(I)
      END DO
      END
